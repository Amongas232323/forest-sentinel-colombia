# ─────────────────────────────────────────────────────────────────────────────
# Forest Sentinel — plantilla de variables de entorno.  cp .env.example .env
# NUNCA suban el .env al repo. Todo lo que diga CHANGE_ME toca cambiarlo sí o sí.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development            # development | staging | production

# Base de datos (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=forest
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=forest_sentinel
POSTGRES_PORT=5433
# Esto se usa cuando corremos la API por fuera de Docker:
DATABASE_URL=postgresql+psycopg://forest:CHANGE_ME_db_password@127.0.0.1:5433/forest_sentinel

# Redis (broker de Celery y el rate limiting)
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6380
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6380/0

# Seguridad — la generamos con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Opcionales (valor por defecto entre paréntesis):
# JWT_ALGORITHM=HS256
# PASSWORD_RESET_MINUTES=30
# MAX_REQUEST_BYTES=2000000
# Lista separada por comas de los orígenes del navegador que pueden llamar a la API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL pública de la app web (la usamos en los links de los correos).
PUBLIC_WEB_URL=http://localhost:3000

# Primer administrador (lo crea `python -m app.seed` solo si todavía no hay ningún admin)
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# Correo (SMTP). En desarrollo el servicio `mailpit` se queda con todo.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=Forest Sentinel <alertas@example.org>

# Pipeline satelital
DATA_DIR=./data
# Ruta opcional a un checkpoint entrenado de la Siamese U-Net. Si va vacío → usamos la línea base por reglas.
MODEL_CHECKPOINT=
PIPELINE_MAX_RUNTIME_S=1800
ALERT_MIN_SEVERITY=moderate        # low | moderate | high | priority
ALERT_MIN_VALID_FRACTION=0.6
ALERT_DEDUP_DAYS=120

# Privacidad — responsable del tratamiento que sale en la política de privacidad (Ley 1581 de 2012)
PRIVACY_CONTROLLER_NAME=CHANGE_ME Nombre de la entidad responsable
PRIVACY_CONTROLLER_ID=CHANGE_ME NIT
PRIVACY_CONTACT_EMAIL=privacidad@example.org
# PRIVACY_POLICY_VERSION=   (opcional; por defecto la versión definida en el código)

# Puertos publicados por docker compose (todos solo en 127.0.0.1). Cámbialos si alguno está ocupado.
# WEB_PORT=3000
# API_PORT=8000
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# SMTP del contenedor (por defecto "mailpit"); el SMTP_HOST de arriba es para ejecutar sin Docker.
# DOCKER_SMTP_HOST=mailpit

# Frontend (Next.js redirige /api/v1/* a este origen; el navegador nunca lo llama directamente)
API_ORIGIN=http://127.0.0.1:8000
